# Split Up - Environment Variables Configuration
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
# -----------------------------------------------------------------------------

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# Supabase Anon API Key (Public / Client-Safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Optional Server-Only Credentials (NEVER expose to NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
