# Split Up - Environment Variables Configuration
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# Supabase Configuration
# Obtain these from your Supabase Dashboard: Settings -> API Keys
# -----------------------------------------------------------------------------

# Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co

# New Supabase Publishable Key (Client-Safe, starts with sb_publishable_...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_abcdefghijklmnopqrstuvwxyz123456

# Legacy Anon Key Fallback (Supported for backwards compatibility)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------------------------------------
# Optional Server-Only Credentials (NEVER expose to NEXT_PUBLIC_)
# -----------------------------------------------------------------------------
# New Supabase Secret Key (Server-Only, starts with sb_secret_...)
# SUPABASE_SECRET_KEY=sb_secret_abcdefghijklmnopqrstuvwxyz123456
# Legacy Service Role Key
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
